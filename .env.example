# ==============================================================================
# CloudVault Environment Configuration Template (.env.example)
# Copy this file to .env or configure your environment variables in your deployment
# NEVER commit real production secrets, passwords, or AWS keys to source control.
# ==============================================================================

# ASP.NET Core Runtime Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Database Connection (Microsoft SQL Server or Amazon RDS for SQL Server)
ConnectionStrings__DefaultConnection=Server=your-rds-endpoint.rds.amazonaws.com,1433;Database=CloudVaultDb;User Id=cloudvault_user;Password=ChangeThisStrongPassw0rd!;TrustServerCertificate=False;Encrypt=True;MultipleActiveResultSets=true;
Database__UseInMemoryDatabase=false

# JWT Authentication
Jwt__Secret=Replace_This_With_A_Super_Secret_Key_At_Least_64_Characters_Long_For_Production_Security!
Jwt__Issuer=CloudVault
Jwt__Audience=CloudVaultUsers
Jwt__ExpiryMinutes=60
Jwt__RefreshTokenExpiryDays=7

# Amazon S3 & AWS Cloud Settings
# In production on AWS ECS/Elastic Beanstalk, use IAM Roles (UseIamRole=true).
# Do not supply AccessKey or SecretKey when running under an IAM Task Role.
Storage__Provider=S3
Storage__S3BucketName=cloudvault-production-storage-bucket
Storage__DefaultQuotaBytes=1073741824
Storage__MaxFileSizeBytes=104857600
AWS__Region=us-east-1
AWS__UseIamRole=true
AWS__ServiceUrl=
AWS__ForcePathStyle=false
AWS__AccessKey=
AWS__SecretKey=

# Local Development Fallbacks (if Storage__Provider is set to "Local")
Storage__LocalStoragePath=app_data/storage
